{
  "name": "tech-challenge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "dev:api": "nx serve api",
    "dev:web": "nx dev web",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema apps/api/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema apps/api/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} apps/api/prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@nx/eslint": "19.0.0",
    "@nx/eslint-plugin": "19.0.0",
    "@nx/jest": "19.0.0",
    "@nx/js": "19.0.0",
    "@nx/nest": "19.0.0",
    "@nx/next": "19.0.0",
    "@nx/node": "19.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.57.0",
    "nx": "19.0.0",
    "prisma": "^5.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0"
  }
}
